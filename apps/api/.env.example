DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postn"
REDIS_URL="redis://localhost:6381"
PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# Google login is parked. Email/password is the current auth path.
# Restore GOOGLE_* and re-register GoogleStrategy when OAuth comes back.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# X — leave empty for a demo channel. Paste keys to switch Connect to live OAuth.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_CALLBACK_URL="http://localhost:4000/social/callback/twitter"

# LinkedIn — leave empty for a demo channel. Paste keys to switch Connect to live OAuth.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_CALLBACK_URL="http://localhost:4000/social/callback/linkedin"
LINKEDIN_PAGE_CALLBACK_URL="http://localhost:4000/social/callback/linkedin-page"

# Cloudflare R2 (S3 API). Objects live under R2_PREFIX so they stay in their own folder.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""
R2_PREFIX="postn"
ANTHROPIC_API_KEY=""
# Gemini image gen (Nano / gemini-2.5-flash-image). Same key as Google AI Studio.
GOOGLE_AI_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RESEND_API_KEY=""
