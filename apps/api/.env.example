DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postn"
REDIS_URL="redis://localhost:6381"
# Production must use redis://:password@host:port (or rediss://). Local compose has no AUTH.
PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
# Separate from JWT_SECRET. Used to encrypt LinkedIn/X/Telegram tokens at rest.
TOKEN_ENCRYPTION_KEY="replace-with-a-different-long-random-string"
FRONTEND_URL="http://localhost:3000"
# Optional comma-separated extra origins (apex/www is derived from FRONTEND_URL).
FRONTEND_URLS=""
BACKEND_URL="http://localhost:4000"

# Google sign in / sign up. Add GOOGLE_CALLBACK_URL in the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# X — leave empty for a demo channel. Paste keys to switch Connect to live OAuth.
# Sign in / sign up reuses these keys. Add TWITTER_LOGIN_CALLBACK_URL in the X app.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_CALLBACK_URL="http://localhost:4000/social/callback/twitter"
TWITTER_LOGIN_CALLBACK_URL="http://localhost:4000/auth/twitter/callback"

# LinkedIn — leave empty for a demo channel. Paste keys to switch Connect to live OAuth.
# Sign in / sign up reuses these keys. Add LINKEDIN_LOGIN_CALLBACK_URL in the LinkedIn app.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_CALLBACK_URL="http://localhost:4000/social/callback/linkedin"
LINKEDIN_PAGE_CALLBACK_URL="http://localhost:4000/social/callback/linkedin-page"
LINKEDIN_LOGIN_CALLBACK_URL="http://localhost:4000/auth/linkedin/callback"

# Cloudflare R2 (S3 API). Dashboard → R2 → bucket. Account ID is in the right sidebar.
# Endpoint can be omitted when ACCOUNT_ID is set: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL is the r2.dev public development URL (or a custom domain) for the same bucket.
# Disable public listing. Publish loads objects with getObject; the app can also use /media/file.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""
R2_PREFIX="postn"
ANTHROPIC_API_KEY=""
# Gemini image gen (Nano Banana 2 / gemini-3.1-flash-image). Same key as Google AI Studio.
GOOGLE_AI_API_KEY=""
# Optional override. Default is gemini-3.1-flash-image (2.5 Flash Image retired 2 Oct 2026).
GEMINI_IMAGE_MODEL=""
# none | razorpay | stripe. Checkout is an adapter — do not grant plans from success URLs.
# KEY_SECRET stays on the API. Never put it in Next.js or NEXT_PUBLIC_*.
BILLING_PROVIDER="none"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Accounts & Settings → Webhooks. Not the Key Secret.
# URL must be HTTPS on port 443 (Razorpay will not POST to localhost:4000).
# Test: https://<public-api-host>/billing/webhook
# Live: same path on the production API host.
# Events: subscription.activated, subscription.charged, subscription.cancelled,
#         subscription.completed, subscription.pending, subscription.halted,
#         payment.captured, payment.failed
# Test-mode OTP when saving a webhook: 754081
RAZORPAY_WEBHOOK_SECRET=""
# Optional. If empty, the API creates/reuses Razorpay Plans named "postN PRO monthly" etc.
RAZORPAY_PLAN_PRO_MONTHLY=""
RAZORPAY_PLAN_PRO_YEARLY=""
RAZORPAY_PLAN_STUDIO_MONTHLY=""
RAZORPAY_PLAN_STUDIO_YEARLY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Transactional mail (welcome, trial, publish, billing). Same key as waitlist on the web app.
# Leave empty to skip sending. Resend free tier: 3,000 / month.
RESEND_API_KEY=""
RESEND_FROM="postN <hello@postind.xyz>"
WAITLIST_NOTIFY_EMAIL="nilamadhab47@gmail.com"
