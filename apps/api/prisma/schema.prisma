generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  STUDIO
}

enum Platform {
  TWITTER
  LINKEDIN
  LINKEDIN_PAGE
  TELEGRAM
  MEDIUM
  DEVTO
  SLACK
  DISCORD
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  image          String?
  passwordHash   String?
  googleId       String?  @unique
  linkedinId     String?  @unique
  twitterId      String?  @unique
  emailVerified  DateTime?
  plan              Plan      @default(FREE)
  billingExempt     Boolean   @default(false)
  timezone          String    @default("Asia/Kolkata")
  trialStartedAt    DateTime?
  trialEndsAt       DateTime?
  trialUsed         Boolean   @default(false)
  trialClosedAt     DateTime?
  trialReminded3dAt DateTime?
  trialReminded1dAt DateTime?
  postsThisMonth    Int       @default(0)
  postsResetAt      DateTime?
  postsToday        Int       @default(0)
  postsTodayResetAt DateTime?
  imageGensUsed     Int       @default(0)
  aiCallsUsed       Int       @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  socialAccounts SocialAccount[]
  posts          Post[]
  media          Media[]
  notifications  Notification[]
  subscription   Subscription?
  checkouts      BillingCheckout[]
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  platform     Platform
  platformId   String
  username     String?
  displayName  String?
  avatar       String?
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  isActive     Boolean   @default(true)
  isMock       Boolean   @default(false)
  pausedByPlan Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts PostTarget[]

  @@unique([platform, platformId])
  @@unique([userId, platform])
  @@index([userId])
}

model Post {
  id                String     @id @default(cuid())
  userId            String
  content           String
  contentByPlatform Json?
  mediaUrls         String[]
  status            PostStatus @default(DRAFT)
  scheduledAt       DateTime?
  publishedAt       DateTime?
  failedReason      String?
  aiGenerated       Boolean    @default(false)
  jobId             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets       PostTarget[]
  notification  Notification?

  @@index([userId, status])
  @@index([scheduledAt])
}

model PostTarget {
  id              String     @id @default(cuid())
  postId          String
  socialAccountId String
  platformPostId  String?
  status          PostStatus @default(SCHEDULED)
  publishedAt     DateTime?
  failedReason    String?
  idempotencyKey  String     @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([socialAccountId])
}

model Media {
  id        String   @id @default(cuid())
  userId    String
  key       String   @unique
  url       String
  mimeType  String
  fileName  String
  bytes     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  postId    String            @unique
  kind      NotificationKind
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationKind {
  PUBLISHED
  FAILED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum BillingProvider {
  NONE
  RAZORPAY
  STRIPE
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum CheckoutStatus {
  OPEN
  COMPLETED
  EXPIRED
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  plan                   Plan
  interval               BillingInterval
  status                 SubscriptionStatus
  provider               BillingProvider
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingCheckout {
  id          String          @id @default(cuid())
  userId      String
  plan        Plan
  interval    BillingInterval
  provider    BillingProvider
  providerRef String?
  status      CheckoutStatus  @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerRef])
}

model BillingEvent {
  id              String          @id @default(cuid())
  provider        BillingProvider
  providerEventId String
  type            String
  userId          String?
  checkoutId      String?
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@unique([provider, providerEventId])
  @@index([userId])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
