# Vercel production:
# NEXT_PUBLIC_SITE_URL=https://www.postind.xyz

# Production (Vercel) hides Sign in and shows the waitlist by default.
# Local `next dev` keeps auth. Force either way:
# NEXT_PUBLIC_WAITLIST_MODE=true

# Waitlist emails (Vercel env). Resend free tier: 3,000 emails/month.
# Confirmations to subscribers need a verified domain in RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM="postN <onboarding@resend.dev>"
WAITLIST_NOTIFY_EMAIL=nilamadhab47@gmail.com

